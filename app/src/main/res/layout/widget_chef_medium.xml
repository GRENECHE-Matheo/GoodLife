<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget moyen (4×2) : le chef et son petit mot, la série, deux raccourcis (photo d'un repas, + 1 verre d'eau),
    les jauges du jour (calories, pas, eau, protéines) et le prochain repas prévu dans le planning.
    Les textes et chiffres ci-dessous ne servent qu'à l'aperçu (liste des widgets) : ChefWidgets les remplace
    tous à chaque mise à jour et masque ce qui ne tient pas dans la taille du widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_chef"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/widget_chef_circle"
            android:contentDescription="@string/widget_chef_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_chef_preview" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_streak"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_streak"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/widget_preview_streak"
                android:textColor="@color/widget_streak_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_preview_message"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_btn_photo"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_btn_photo_desc"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_camera"
                android:tint="@color/widget_btn_text" />

            <TextView
                android:id="@+id/widget_btn_photo_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_btn_photo"
                android:textColor="@color/widget_btn_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_water"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_btn_water_desc"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_water"
                android:tint="@color/widget_btn_text" />

            <TextView
                android:id="@+id/widget_btn_water_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_btn_water"
                android:textColor="@color/widget_btn_text"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_kcal_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_kcal_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_lbl_kcal"
                android:textColor="@color/widget_accent_strong"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_kcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="1 240 / 2 100"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_kcal_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="62"
                android:progressDrawable="@drawable/widget_bar_kcal" />

            <TextView
                android:id="@+id/widget_kcal_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_kcal_left"
                android:textColor="@color/widget_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_steps_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_steps_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_lbl_steps"
                android:textColor="@color/widget_steps"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="5 432"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_steps_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="55"
                android:progressDrawable="@drawable/widget_bar_steps" />

            <TextView
                android:id="@+id/widget_steps_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="/ 8 000"
                android:textColor="@color/widget_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_water_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_water_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_lbl_water"
                android:textColor="@color/widget_water"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="750 ml"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_water_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="55"
                android:progressDrawable="@drawable/widget_bar_water" />

            <TextView
                android:id="@+id/widget_water_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="/ 1 500 ml"
                android:textColor="@color/widget_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_protein_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_protein_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_lbl_protein"
                android:textColor="@color/widget_protein"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_protein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="62 g"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_protein_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="55"
                android:progressDrawable="@drawable/widget_bar_protein" />

            <TextView
                android:id="@+id/widget_protein_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="/ 110 g"
                android:textColor="@color/widget_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_meal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_meal"
            android:tint="@color/widget_accent_strong" />

        <TextView
            android:id="@+id/widget_meal_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_meal"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
